{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts", "scripts/render_studies.tsx"]
}
